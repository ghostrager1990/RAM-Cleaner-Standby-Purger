<Window x:Class="RamCleaner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="RAM Cleaner &amp; Standby Purger" Height="625" Width="520"
        Icon="RAMCleanerappicon.png"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Background="#1E1E2E" Foreground="#CDD6F4" FontFamily="Segoe UI">

    <Window.Resources>
        <!-- ToolTip Styling -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#11111B"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#89B4FA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HasDropShadow" Value="True"/>
        </Style>

        <!-- ToolTip 2-Second Delay -->
        <Style TargetType="FrameworkElement">
            <Setter Property="ToolTipService.InitialShowDelay" Value="2000"/>
            <Setter Property="ToolTipService.ShowDuration" Value="10000"/>
            <Setter Property="ToolTipService.BetweenShowDelay" Value="500"/>
        </Style>

        <!-- Dark ContextMenu & System Tray Menu Styling -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#181825"/>
            <Setter Property="BorderBrush" Value="#313244"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="Padding" Value="4,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#313244"/>
                                <Setter Property="Foreground" Value="#89B4FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Margin" Value="4,3"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Background="{TemplateBinding Background}" Height="1" Margin="{TemplateBinding Margin}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark TabItem Style -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="Border" Background="{TemplateBinding Background}" CornerRadius="4,4,0,0" Margin="0,0,4,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#181825"/>
                                <Setter Property="Foreground" Value="#89B4FA"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <!-- 1. Row Definitions -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 2. System Tray Icon -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        Visibility="Collapsed"
                        ToolTipText="RAM Cleaner (Double-click to open)"
                        TrayMouseDoubleClick="TrayIcon_TrayMouseDoubleClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Flush All Now" Click="BtnFlushAll_Click"/>
                    <Separator/>
                    <MenuItem Header="Open Dashboard" Click="MenuOpen_Click"/>
                    <MenuItem Header="Exit" Click="MenuExit_Click"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <!-- 3. Header Dashboard (Row 0) -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Image Grid.Column="0" Source="RAMCleanerappicon.png" Width="44" Height="44" Margin="0,0,12,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="RAM MONITOR &amp; PURGER" FontWeight="Bold" FontSize="16" Foreground="#89B4FA"/>
                <TextBlock x:Name="TxtStatus" Text="Status: Monitoring" FontSize="12" Foreground="#A6ADC8" Margin="0,3,0,0"
                           ToolTip="Live status of memory monitoring, recent flushes, or active game pauses."/>
            </StackPanel>
        </Grid>

        <!-- 4. Memory Gauge (Row 1) -->
        <Border Grid.Row="1" Background="#181825" CornerRadius="8" Padding="12" Margin="0,0,0,14"
                ToolTip="Current overall system physical memory utilization.">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <TextBlock x:Name="TxtMemoryUsage" Text="Memory Load: 0%" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock x:Name="TxtMemoryDetails" Text="0.0 GB / 0.0 GB" HorizontalAlignment="Right" Foreground="#A6ADC8"/>
                </Grid>
                <ProgressBar x:Name="PbMemory" Height="12" Minimum="0" Maximum="100" Value="0" Foreground="#A6E3A1" Background="#313244" BorderThickness="0"/>
            </StackPanel>
        </Border>

        <!-- 5. Tab Controls (Row 2) -->
        <TabControl Grid.Row="2" Background="#181825" BorderThickness="0">
            <!-- Triggers Tab -->
            <TabItem Header="Triggers &amp; Startup">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Manual Flush Targets" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#CBA6F7"/>
                        <Button Content="Flush Working Sets" Click="BtnWorkingSets_Click" Margin="0,0,0,6" Height="28" Background="#313244" Foreground="#CDD6F4"
                                ToolTip="Trims unused memory pages from process working sets and pushes them to Standby/Modified lists."/>
                        <Button Content="Flush Modified Pages" Click="BtnModified_Click" Margin="0,0,0,6" Height="28" Background="#313244" Foreground="#CDD6F4"
                                ToolTip="Forces all modified cache pages to write uncommitted data to disk and move to the Standby list."/>
                        <Button Content="Purge Standby (P0)" Click="BtnP0Standby_Click" Margin="0,0,0,6" Height="28" Background="#313244" Foreground="#CDD6F4"
                                ToolTip="Clears only the lowest-priority (Priority 0) Standby memory cache without evicting high-priority cached data."/>
                        <Button Content="Purge Standby (All)" Click="BtnStandby_Click" Height="28" Background="#313244" Foreground="#CDD6F4"
                                ToolTip="Completely flushes all priority levels of the Windows Standby memory cache, freeing up max physical RAM."/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Automation Triggers" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#FAB387"/>

                        <CheckBox x:Name="ChkThreshold" Content="Auto-flush when RAM &gt;=" Foreground="#CDD6F4" Margin="0,0,0,4"
                                  ToolTip="Enables automated memory flushing when total RAM usage exceeds the configured percentage."/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                    ToolTip="Set the percentage threshold at which an automatic memory flush is triggered.">
                            <Slider x:Name="SliderThreshold" Minimum="50" Maximum="95" Value="85" Width="100" TickFrequency="5" IsSnapToTickEnabled="True"/>
                            <TextBlock Text="{Binding Value, ElementName=SliderThreshold, StringFormat={}{0}%}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <CheckBox x:Name="ChkInterval" Content="Auto-flush on interval:" Foreground="#CDD6F4" Margin="0,0,0,4"
                                  ToolTip="Enables automated memory flushing on a recurring time schedule."/>
                        <ComboBox x:Name="CmbInterval" SelectedIndex="0" Margin="0,0,0,12" Background="#313244" Foreground="#11111B">
                            <ComboBoxItem Content="Every 15 Minutes"/>
                            <ComboBoxItem Content="Every 30 Minutes"/>
                            <ComboBoxItem Content="Every 1 Hour"/>
                            <ComboBoxItem Content="Every 2 Hours"/>
                        </ComboBox>

                        <TextBlock Text="Startup Options" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="#89DCEB"/>
                        <CheckBox x:Name="ChkStartWindows" Content="Start when Windows starts" Foreground="#CDD6F4" Margin="0,0,0,4"
                                  ToolTip="Registers the app in the Windows CurrentUser Run registry to launch automatically on login."/>
                        <CheckBox x:Name="ChkStartMinimized" Content="Start minimized in Tray" Foreground="#CDD6F4"
                                  ToolTip="Launches directly to the system tray without opening the main window."/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Exclusion List Tab -->
            <TabItem Header="Exclusion List (Game Pause)">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Pause auto-flushing while any of these apps are running:" Foreground="#A6ADC8" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <ListBox x:Name="LstExclusions" Grid.Row="1" Background="#11111B" Foreground="#CDD6F4" BorderBrush="#313244" Margin="0,0,0,8"
                             ToolTip="Select an executable from this list and click Remove to unblock it."/>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtNewProcess" Grid.Column="0" Height="28" Background="#313244" Foreground="#CDD6F4" BorderThickness="0" Padding="4,4" VerticalContentAlignment="Center"
                                 ToolTip="Type the executable name (e.g., game.exe or obs64.exe) to pause flushing when active."/>
                        <Button Content="Add App" Grid.Column="1" Click="BtnAddExclusion_Click" Margin="6,0,0,0" Padding="12,0" Height="28" Background="#A6E3A1" Foreground="#11111B" FontWeight="Bold"
                                ToolTip="Add the typed process name to the exclusion pause list."/>
                        <Button Content="Remove" Grid.Column="2" Click="BtnRemoveExclusion_Click" Margin="6,0,0,0" Padding="12,0" Height="28" Background="#F38BA8" Foreground="#11111B" FontWeight="Bold"
                                ToolTip="Remove the selected process from the exclusion list."/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- About Tab -->
            <TabItem Header="About">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12,8,8,8">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="About RAM Cleaner &amp; Standby Purger" FontWeight="Bold" FontSize="13" Foreground="#89B4FA" Margin="0,0,0,6"/>
                        <TextBlock Text="A lightweight Windows utility designed to monitor physical RAM and reclaim unreleased or cached memory lists via native NT kernel interfaces." TextWrapping="Wrap" Foreground="#CDD6F4" FontSize="11" Margin="0,0,0,10" LineHeight="16"/>

                        <TextBlock Text="What It Does" FontWeight="SemiBold" FontSize="12" Foreground="#CBA6F7" Margin="0,0,0,4"/>
                        <TextBlock Text="• Flushes Working Sets: Trims inactive pages from running processes.&#x0a;• Flushes Modified Pages: Commits dirty cache to disk, converting pages to standby.&#x0a;• Purges Standby Lists: Clears cached pages (Priority 0 or all levels) to release memory directly into free physical RAM.&#x0a;• Game Pause: Suspends automated cleaning during gaming or recording sessions to prevent micro-stutters." TextWrapping="Wrap" Foreground="#A6ADC8" FontSize="11" Margin="0,0,0,10" LineHeight="17"/>

                        <TextBlock Text="⚠️ Gaming &amp; Performance Note" FontWeight="SemiBold" FontSize="12" Foreground="#F38BA8" Margin="0,0,0,4"/>
                        <TextBlock Text="Flushing RAM will not crash running games, but purging caches or trimming working sets mid-game can cause temporary micro-stutter while assets reload from disk. It is recommended to flush before launching games or add your game executable to the Exclusion List." TextWrapping="Wrap" Foreground="#A6ADC8" FontSize="11" Margin="0,0,0,10" LineHeight="16"/>

                        <TextBlock Text="License &amp; Third-Party Notices" FontWeight="SemiBold" FontSize="12" Foreground="#FAB387" Margin="0,0,0,4"/>
                        <TextBlock Text="• Application &amp; Engine: Licensed under the MIT License.&#x0a;• H.NotifyIcon.Wpf: Licensed under the MIT License (Copyright © HavenDV).&#x0a;• Graphics: Provided royalty-free under the Pixabay Content License." TextWrapping="Wrap" Foreground="#A6ADC8" FontSize="11" LineHeight="16"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- 6. Bottom Action Buttons (Row 3) -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Content="CLEAN ALL RAM LISTS NOW" Click="BtnFlushAll_Click" Height="36" FontWeight="Bold" Background="#F38BA8" Foreground="#11111B" BorderThickness="0"
                    ToolTip="Performs a full sweep across working sets, modified pages, and standby lists. Note: Running mid-game may cause brief micro-stutter as cached assets are reloaded."/>
            <Button Content="Save Settings" Grid.Column="1" Click="BtnSaveSettings_Click" Margin="8,0,0,0" Height="36" Background="#89B4FA" Foreground="#11111B" FontWeight="Bold" BorderThickness="0"
                    ToolTip="Saves all thresholds, intervals, startup preferences, and exclusion lists to disk."/>
        </Grid>

        <!-- 7. Footer Attribution (Row 4) -->
        <TextBlock Grid.Row="4" Text="by Stanorius" FontSize="11" Foreground="#585B70" HorizontalAlignment="Right" Margin="0,6,2,0"/>
    </Grid>
</Window>